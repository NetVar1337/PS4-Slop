{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ps4-mcp": {
        "type": "local",
        "command": [
          "C:/path/to/PS4-MCP/target/release/ps4-mcp.exe",
          "--profile",
          "C:/path/to/PS4-MCP/profiles/ps4-1400.local.json",
          "--toolset",
          "read-only",
          "serve"
        ],
        "enabled": true
      },
      "binary-ninja": {
        "type": "remote",
        "url": "http://127.0.0.1:24642/mcp",
        "enabled": true
      },
      "radare2": {
        "type": "local",
        "command": ["C:/path/to/r2mcp.exe"],
        "enabled": true
      }
    }
  }
}
