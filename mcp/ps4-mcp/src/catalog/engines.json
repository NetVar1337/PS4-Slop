      },
      "td_name": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "td_offset": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "td_type": {
       "type": "integer",
       "minimum": 0,
