[
 {
  "name": "il2cpp_dump",
  "description": "Unity IL2CPP metadata recovery: parse global-metadata.dat (magic 0xFAB11BAF, versions 24.0-29) from an artifact or locate it in live memory (pid; validated header), optionally map method pointers to RVAs by locating Il2CppCodeRegistration code-gen modules (or <=24.1 method pointer array) in the game binary (ELF/raw artifact or pid+module), with explicit address/version overrides. Saves a dump.cs-like text and a ps4wb-il2cpp-v1 JSON (methods with rva/name/class/namespace/signature, types, string literals). Read-only.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "metadata_artifact": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024,
     "description": "global-metadata.dat artifact (relative path)"
    },
    "pid": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2147483647,
     "description": "Live process: search readable maps for the metadata (unless metadata_artifact is given) and/or read the binary module"
    },
    "metadata_address": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Explicit live address of the metadata header (skips the search)"
    },
    "binary_artifact": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024,
     "description": "Decrypted game ELF (mapped by PT_LOAD with relocations) or raw memory dump (see binary_base)"
    },
    "binary_base": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Load address of a raw binary dump artifact"
    },
    "module": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256,
     "description": "Live binary module name (with pid), e.g. eboot.bin"
    },
    "version": {
     "type": "number",
     "minimum": 24,
     "maximum": 29,
     "description": "Override metadata version (e.g. 24.1, 24.2, 27)"
    },
    "code_gen_modules": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Override: address of the Il2CppCodeGenModule* array (v24.2+)"
    },
    "method_pointers": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Override: address of the global methodPointers array (v24.0/24.1)"
    },
    "metadata_registration": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Override: address of Il2CppMetadataRegistration (enables type names)"
    },
    "include_dump_cs": {
     "type": "boolean",
     "description": "Also save the dump.cs-like text (default true)"
    },
    "max_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 17179869184,
     "description": "Live byte budget (clamped to the profile transfer_bytes)"
    }
   },
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true
  },
  "permission": null
 },
 {
  "name": "unreal_dump",
  "description": "Unreal Engine name/object recovery from live memory (pid [+ module]) or a raw memory-dump artifact: locate GNames (UE4 <4.23 TNameEntryArray or 4.23+/UE5 FNamePool) via the 'None','ByteProperty' first-entries heuristic or explicit gnames, walk GObjects (FUObjectArray chunked) for class/outer names, and optionally emit a best-effort SDK-style class/property listing (UStruct/FProperty offsets overridable). Bounded counts. Read-only.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "artifact": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024,
     "description": "Raw memory dump artifact (pointers must resolve inside it)"
    },
    "base": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Load address of the dump artifact"
    },
    "pid": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2147483647
    },
    "module": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256,
     "description": "Live module whose writable data holds GNames/GObjects (default: search all writable maps)"
    },
    "gnames": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Override: FNamePool Blocks[0] slot address (name_pool) or TNameEntryArray address (name_array)"
    },
    "gnames_kind": {
     "type": "string",
     "enum": [
      "auto",
      "name_pool",
      "name_array"
     ]
    },
    "gobjects": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Override: address of FUObjectArray (GUObjectArray)"
    },
    "version": {
     "type": "string",
     "maxLength": 16,
     "pattern": "^[45](\\.[0-9]{1,2}){0,2}$",
     "description": "Engine version hint, e.g. 4.22, 4.27, 5.1"
    },
    "max_names": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2000000
    },
    "max_objects": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2000000
    },
    "sdk": {
     "type": "boolean",
     "description": "Emit best-effort class/property listing (default true)"
    },
    "offsets": {
     "type": "object",
     "description": "Layout overrides (bytes)",
     "properties": {
      "object_class": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "object_name": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "object_outer": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "objobjects": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "item_size": {
       "type": "integer",
       "minimum": 8,
       "maximum": 256
      },
      "name_entry_string": {
       "type": "integer",
       "minimum": 0,
       "maximum": 64
      },
      "struct_super": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "struct_children": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "struct_child_properties": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "struct_size": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "field_next": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "field_name": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "field_class": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "property_element_size": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "property_offset": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      }
     },
     "additionalProperties": false
    },
    "max_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 17179869184
    }
   },
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true
  },
  "permission": null
 },
 {
  "name": "rtti_recover",
  "description": "Itanium C++ ABI RTTI/vtable recovery over an ELF artifact (PT_LOAD mapping, relocations applied), raw dump (base) or pid+module: finds class/si/vmi type_info objects structurally, demangles class names (subset; keeps mangled when unsure), recovers inheritance and vtables with virtual function RVAs. Saves ps4wb-classes-v1 JSON. Read-only.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "artifact": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024
    },
    "base": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Load address for raw (non-ELF) artifacts"
    },
    "pid": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2147483647
    },
    "module": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "class_typeinfo_vtable": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Override: vptr value of __class_type_info objects"
    },
    "si_typeinfo_vtable": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$"
    },
    "vmi_typeinfo_vtable": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$"
    },
    "max_classes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "max_virtuals": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8192
    },
    "max_bytes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 17179869184
    }
   },
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true
  },
  "permission": null
 },
 {
