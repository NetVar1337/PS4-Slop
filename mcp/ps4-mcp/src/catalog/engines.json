 {
  "name": "source_dump",
  "description": "Source-engine metadata recovery (Valve Source and forks such as Respawn's Titanfall/Apex Legends engine) from live memory (pid + module, default eboot.bin) or a mapped artifact (ELF, or raw dump with base): ClientClass list (names, class ids, RecvTables), nested RecvTable/RecvProp network tables (names, offsets, raw types), datamap_t/typedescription_t data descriptions, ConVar/ConCommand list and InterfaceReg (CreateInterface) list. Field layouts are inferred from how anchor strings link up (never assumed); results include the chosen layout per structure with confidence and alternatives, and every offset can be pinned via `layout`. Saves a JSON artifact and a text listing. Read-only.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "artifact": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024,
     "description": "Module ELF artifact (e.g. elf_rebuild output) or raw memory dump (with base)"
    },
    "base": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^(0x[0-9a-fA-F]{1,16}|[0-9]{1,20})$",
     "description": "Load address of a raw dump artifact"
    },
    "pid": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2147483647
    },
    "module": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256,
     "description": "Live module to search (default eboot.bin)"
    },
    "max_bytes": {
     "type": "integer",
     "minimum": 4096,
     "maximum": 4294967296,
     "description": "Live read budget (clamped to the profile transfer_bytes)"
    },
    "sections": {
     "type": "array",
     "minItems": 1,
     "maxItems": 5,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "enum": [
       "client_classes",
       "recv_tables",
       "datamaps",
       "convars",
       "interfaces"
      ]
     },
     "description": "Default: all"
    },
    "layout": {
     "type": "object",
     "additionalProperties": false,
     "description": "Pin field offsets (bytes) instead of inferring them: cc_* ClientClass, rt_* RecvTable, rp_* RecvProp, dm_* datamap_t, td_* typedescription_t, cv_* ConCommandBase, if_* InterfaceReg",
     "properties": {
      "cc_name": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "cc_next": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "cc_recv_table": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "cc_class_id": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rt_name": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rt_props": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rt_count": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rp_stride": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rp_name": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rp_offset": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rp_type": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "rp_data_table": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "dm_desc": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "dm_count": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "dm_class": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "dm_base": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4096
      },
      "td_stride": {
       "type": "integer",
       "minimum": 0,
