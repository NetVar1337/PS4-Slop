 {
  "name": "project_research_export",
  "description": "Generate typed C++ SDK views and feature availability from live-validated findings.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "project": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,96}$"
    }
   },
   "required": [],
