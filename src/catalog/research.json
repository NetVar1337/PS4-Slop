    "project": {
     "type": "string"
    }
   },
   "required": [],
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  },
  "permission": null
 }
