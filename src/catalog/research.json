 {
  "name": "project_install",
  "description": "Install generated SDK/target/research headers into the registered repository after build/title checks. Never overwrites user-authored headers or deploys.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "project": {
     "type": "string",
     "maxLength": 1024
    },
    "engine": {
     "type": "string",
     "maxLength": 1024
    },
    "offsets": {
     "type": "string",
     "maxLength": 1024
    },
    "target": {
     "type": "string",
     "maxLength": 1024
    }
   },
   "required": [
    "target"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  },
  "permission": null
 },
 {
  "name": "payload_scaffold",
  "description": "Create a self-contained buildable diagnostic resident payload with shared runtime, UE4/Source readers, protocol negotiation and host lifecycle tests.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "maxLength": 64
    },
    "engine": {
     "enum": [
      "generic",
      "source",
      "unreal"
     ],
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  },
  "permission": null
 },
 {
  "name": "project_collect_build",
  "description": "Verify registered-repository build evidence, source pins, ELF architecture/entry/RPC export and payload hash, then ingest immutable build evidence and ELF artifacts. Never deploys.",
  "inputSchema": {
