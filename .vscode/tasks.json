{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: C++ (engine, ImGui shell, tests)",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/build.ps1", "-NoFrontend"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build: C++ + run tests",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/build.ps1", "-NoFrontend", "-Test"],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "build: full app (Tauri installer + portable)",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/build.ps1"],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "clang-tidy",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/clang_tidy.ps1"],
            "problemMatcher": {
                "owner": "clang-tidy",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        }
    ]
}
