// Generated by cmake/slop_resources.cmake from cmake/win_resources.rc.in.
// Embeds the application manifest (RT_MANIFEST, ID 1) and a VERSIONINFO block
// derived from the root VERSION file.
#include <winres.h>

1 24 "@SLOP_RC_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "NetVar1337"
            VALUE "FileDescription",  "@SLOP_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@SLOP_RC_NAME@"
            VALUE "LegalCopyright",   "Copyright (c) 2026 NetVar1337. MIT License."
            VALUE "OriginalFilename", "@SLOP_RC_NAME@.exe"
            VALUE "ProductName",      "reverse-slop"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
