# Extra CMake preset trees (debug, asan, analyze each keep deps in <dir>/_deps)
/build-*/
CMakeUserPresets.json

# IDE / editor state
.vs/
*.user
*.suo
.idea/

# Tauri v2 generated schemas/capabilities, scratch cargo target dirs
app/src-tauri/gen/
app/src-tauri/target-*/

# Tool output
mcp_live_results.json
__pycache__/
*.pyc
/build/
/_ext/
/.cache/

# Local tool caches
.cache/
/.vite/
app/e2e/node_modules/
